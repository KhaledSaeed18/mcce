{
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ],
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["camelCase", "PascalCase", "kebab-case"]
          }
        },
        // Numbered groups are read positionally by term and file name parsing.
        "useNamedCaptureGroup": "off"
      },
      "suspicious": {
        // The PDF text layer and scrollbar styles rely on these features on purpose.
        "useBaseline": "off"
      }
    }
  },
  "overrides": [
    {
      // Vendored shadcn primitives stay as generated so upgrades diff cleanly.
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "nursery": { "useTailwindSortedClasses": "off" }
        }
      }
    },
    {
      // Consumers pass the control through htmlFor or as a child.
      "includes": ["src/components/ui/field.tsx"],
      "linter": {
        "rules": {
          "a11y": { "noLabelWithoutControl": "off" }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "!src/data/drive-index.json",
      "!src/data/resources-index.json",
      "!public/resources/icons",
      "!.claude/skills",
      "!.agents/skills"
    ]
  },
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json"
}
