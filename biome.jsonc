{
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ],
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["camelCase", "PascalCase", "kebab-case"]
          }
        }
      }
    }
  },
  "files": {
    "includes": [
      "!src/data/drive-index.json",
      "!src/data/resources-index.json",
      "!public/resources/icons",
      "!.claude/skills",
      "!.agents/skills"
    ]
  },
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json"
}
